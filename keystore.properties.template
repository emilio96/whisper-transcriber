# Copy to keystore.properties (which is git-ignored) and fill in to sign
# release builds. Without this file assembleRelease still runs, but produces an
# unsigned APK that no device will install.
#
#   keytool -genkey -v -keystore whisper-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias whisper
#
# Keep the .jks file and this file out of version control, and keep a backup:
# losing the key means the app can never be updated on Play under the same id.
storeFile=../whisper-release.jks
storePassword=
keyAlias=whisper
keyPassword=
