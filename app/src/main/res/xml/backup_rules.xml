<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules (API 30 and below; API 31+ uses data_extraction_rules.xml).

   Only the small preference files travel. Whisper models are hundreds of MB to
   several GB and the decoded-audio cache holds the user's recordings: neither
   belongs in a cloud backup, and both are trivially reproducible (re-download /
   re-decode). Listing sharedpref as the only include leaves every other domain
   (files/, cache/, ...) out by construction.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
